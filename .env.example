# OMA Docker Compose settings. Copy this to .env and keep that file private.

# Console
# Compose: host IP on which the console is published. Loopback keeps it local.
OMA_BIND_ADDRESS=127.0.0.1
# Compose: published host port for the console. The container still listens on 3000.
OMA_FRONTEND_PORT=3000
# Console: public browser URL. Blank uses http://localhost:<OMA_FRONTEND_PORT>.
OMA_APP_URL=
# Console auth: require HTTPS for session cookies. Enable when serving over HTTPS.
OMA_COOKIE_SECURE=false
# Console auth: allow account registration through the console.
OMA_REGISTRATION_ENABLED=true
# Console API: serve the /docs endpoint.
OMA_DOCS_ENABLED=true
# Console API: JSON list of additional allowed browser origins.
OMA_CORS_ORIGINS=[]

# Console auth: sign session tokens. Blank reuses or generates .oma-data/.signing-key.
OMA_SECRET_KEY=
# Console auth: sign refresh tokens. Blank uses the main signing key.
OMA_REFRESH_SECRET_KEY=

# Console integrations: enables Composio's tool catalog and hosted MCP sessions.
COMPOSIO_API_KEY=
# Console integrations: Fernet key for encrypting authenticated custom MCP credentials.
# Generate one with: openssl rand -base64 32 | tr '+/' '-_'
OMA_INTEGRATION_ENCRYPTION_KEY=

# Console chat: private URL of a separately running Hermes gateway.
OMA_AGENT_URL=
# Console chat: bearer key for that Hermes gateway.
OMA_AGENT_API_KEY=
