# Optional settings for Docker Compose. The default URL is local to this machine.
OMA_BIND_ADDRESS=127.0.0.1
OMA_FRONTEND_PORT=3000
# OMA_APP_URL=https://oma.example.com
OMA_COOKIE_SECURE=false

# An empty signing key is generated once and saved in .oma-data.
OMA_SECRET_KEY=
OMA_REFRESH_SECRET_KEY=
OMA_REGISTRATION_ENABLED=true
OMA_DOCS_ENABLED=true
OMA_CORS_ORIGINS=[]

# Set a Composio key to enable the tool catalog and hosted MCP sessions.
COMPOSIO_API_KEY=
# Set a Fernet key to encrypt credentials for authenticated MCP endpoints.
# Generate one with: openssl rand -base64 32 | tr '+/' '-_'
OMA_INTEGRATION_ENCRYPTION_KEY=
