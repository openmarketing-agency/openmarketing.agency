# OMA Docker Compose settings. Copy this to .env and keep that file private.

# Console
# Compose: host IP on which the console is published. Loopback keeps it local.
OMA_BIND_ADDRESS=127.0.0.1
# Compose: published host port for the console. The container still listens on 3000.
OMA_FRONTEND_PORT=3000
# Console: public browser URL. Blank uses http://localhost:<OMA_FRONTEND_PORT>.
OMA_APP_URL=
# Console auth: require HTTPS for session cookies. Enable when serving over HTTPS.
OMA_COOKIE_SECURE=false
# Console auth: allow account registration through the console.
OMA_REGISTRATION_ENABLED=true
# Console API: serve the /docs endpoint.
OMA_DOCS_ENABLED=true
# Console API: JSON list of additional allowed browser origins.
OMA_CORS_ORIGINS=[]

# Console auth: sign session tokens. Blank reuses or generates .oma-data/.signing-key.
OMA_SECRET_KEY=

# Console integrations: enables Composio's tool catalog and hosted MCP sessions.
COMPOSIO_API_KEY=
# Console integrations: Fernet key for encrypting authenticated custom MCP credentials.
# Generate one with: openssl rand -base64 32 | tr '+/' '-_'
OMA_INTEGRATION_ENCRYPTION_KEY=

# Console chat: Hermes gateway base URL. The bundled VM defaults to http://vm:8642.
OMA_AGENT_URL=
# Console chat: bearer key for an external Hermes gateway. The bundled VM shares its own key.
OMA_AGENT_API_KEY=

# Hermes VM bootstrap: optional OpenRouter credential; you can also set a provider in Settings.
OPENROUTER_API_KEY=
# Hermes VM bootstrap: override the initial model used for the built-in default profile.
OMA_HERMES_MODEL=
# Hermes VM bootstrap: seconds to wait for clarification; 0 waits indefinitely, blank preserves the saved setting.
OMA_HERMES_CLARIFY_TIMEOUT=
# Hermes VM bootstrap: seed used to derive gateway keys. Blank keeps or creates a seed in the VM volume.
OMA_HERMES_GATEWAY_SEED=
# Hermes VM: absolute path inside the container where Compose mounts the VM data volume.
HERMES_HOME=/opt/data
# Compose: reuse the architecture of an existing Hermes dependency volume when needed.
# OMA_VM_PLATFORM=linux/amd64
# Compose: localhost port for the Hermes gateway.
OMA_GATEWAY_PORT=8642
# Compose: localhost port for the Hermes Dashboard.
OMA_DASHBOARD_PORT=9119
# Compose: localhost port for the Traefik proxy serving catalog apps.
OMA_CATALOG_PORT=18080
# Hermes VM startup: 1 initializes the app catalog; 0 skips initialization.
OMA_INIT_CATALOG=1
# Hermes VM: comma-separated exact HTTPS Streamable HTTP URLs of trusted custom MCP servers.
OMA_CUSTOM_MCP_URLS=

# Camofox and Hermes: shared API key saved to the default and maintenance profile .env files.
# Leave commented to use the key generated by make dev. Uncomment only to supply your own key.
# CAMOFOX_API_KEY=
