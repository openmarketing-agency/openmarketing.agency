{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://oma.local/schemas/playbook.json",
  "title": "OMA playbook manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version", "description", "orchestrator", "agents"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 48 },
    "name": { "$ref": "#/definitions/text" },
    "version": { "$ref": "#/definitions/version" },
    "description": { "$ref": "#/definitions/text" },
    "orchestrator": { "$ref": "#/definitions/agentId" },
    "agents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/agentId" } }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "agentId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*__[a-z0-9]+(?:[-_][a-z0-9]+)*$", "maxLength": 64 },
    "ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" } },
    "disclosure": {
      "type": "object",
      "properties": {
        "enabled": { "enum": ["auto", "on", "off", true, false] },
        "eager_toolsets": { "anyOf": [{ "$ref": "#/definitions/ids" }, { "type": "null" }] },
        "defer_toolsets": { "$ref": "#/definitions/ids" },
        "defer": { "$ref": "#/definitions/ids" }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "schedule", "prompt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$" },
        "name": { "$ref": "#/definitions/text" },
        "schedule": { "$ref": "#/definitions/text" },
        "prompt": { "$ref": "#/definitions/text" },
        "timezone": { "type": ["string", "null"], "minLength": 1 },
        "skills": { "$ref": "#/definitions/ids" },
        "repeat": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "agent": {
      "type": "object",
      "required": ["id", "description", "version", "oma_skills"],
      "properties": {
        "id": { "$ref": "#/definitions/agentId" },
        "description": { "$ref": "#/definitions/text" },
        "version": { "$ref": "#/definitions/version" },
        "oma_skills": { "$ref": "#/definitions/ids" },
        "jobs": { "type": "array", "items": { "$ref": "#/definitions/job" } },
        "agent": {
          "type": "object",
          "properties": {
            "enabled_toolsets": { "anyOf": [{ "$ref": "#/definitions/ids" }, { "type": "null" }] },
            "disabled_toolsets": { "$ref": "#/definitions/ids" }
          }
        },
        "skills": {
          "type": "object",
          "properties": {
            "enabled": { "anyOf": [{ "$ref": "#/definitions/ids" }, { "type": "null" }] },
            "disabled": { "$ref": "#/definitions/ids" },
            "auto_load": { "$ref": "#/definitions/ids" }
          }
        },
        "tools": {
          "type": "object",
          "properties": { "tool_search": { "$ref": "#/definitions/disclosure" } }
        },
        "tool_search": { "$ref": "#/definitions/disclosure" },
        "kanban": { "type": "object" },
        "cron": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
